<Window x:Class="KsgMail.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:KsgMail.Core;assembly=KsgMail.Core" Title="Wysyłka masowa z medycyny pracy" Width="1180" Height="820"
 MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen" Closing="OnClosing" ContentRendered="WindowContentRendered">
 <DockPanel Margin="22">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
   <StackPanel><TextBlock Text="Wysyłka masowa z medycyny pracy" FontSize="28" FontWeight="SemiBold" Foreground="#173B69"/>
    <TextBlock Text="Dokumenty dla firm · szyfrowany ZIP · codzienna wysyłka" Foreground="#526477"/></StackPanel>
  </Grid>
  <Border DockPanel.Dock="Bottom" Background="#E5EDF6" Padding="12" Margin="0,14,0,0">
   <DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Anuluj operację" Click="CancelOperation" IsEnabled="False"/>
    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
     <TextBlock x:Name="StatusText" Text="Gotowy. Uzupełnij SMTP i dodaj firmy." VerticalAlignment="Center" TextWrapping="Wrap"/>
    </ScrollViewer></DockPanel>
  </Border>
  <TabControl x:Name="Tabs">
   <TabItem Header="  Firmy  ">
    <Grid Margin="14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,18,0">
      <StackPanel DockPanel.Dock="Top">
       <WrapPanel>
        <Button Content="Nowa firma" Click="NewCustomer"/>
        <Button Content="Import CSV…" Click="ImportCsv"/>
        <Button Content="Eksport CSV…" Click="ExportCsv"/>
       </WrapPanel>
       <WrapPanel Margin="0,8,0,4">
        <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="CustomerSearch" Width="230" TextChanged="CustomerFilterChanged" Margin="0,0,14,0"/>
        <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="CustomerStateFilter" Width="125" SelectedIndex="0" SelectionChanged="CustomerFilterChanged">
         <ComboBoxItem Content="Wszystkie"/>
         <ComboBoxItem Content="Aktywne"/>
         <ComboBoxItem Content="Nieaktywne"/>
        </ComboBox>
        <TextBlock x:Name="CustomerCountText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#526477"/>
       </WrapPanel>
       <WrapPanel Margin="0,0,0,8">
        <Button Content="Zaznacz wszystkie widoczne" Click="SelectAllVisibleCustomers"/>
        <Button Content="Wyczyść zaznaczenie" Click="ClearCustomerSelection"/>
        <Button Content="Aktywuj zaznaczone" Click="ActivateSelectedCustomers"/>
        <Button Content="Dezaktywuj zaznaczone" Click="DeactivateSelectedCustomers"/>
        <Button Content="Usuń zaznaczone" Click="DeleteCustomer"/>
       </WrapPanel>
      </StackPanel>
      <DataGrid x:Name="CustomersGrid" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="CustomerSelected">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Firma" Binding="{Binding Name}" Width="*" MinWidth="160"/>
        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" MinWidth="210"/>
        <DataGridCheckBoxColumn Header="Aktywna" Binding="{Binding Active}" Width="70"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="Konfiguracja firmy" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <TextBlock Text="Nazwa firmy"/><TextBox x:Name="CustomerName"/>
       <TextBlock Text="Adres e-mail"/><TextBox x:Name="CustomerEmail"/>
       <TextBlock Text="Temat wiadomości"/><TextBox x:Name="CustomerSubject"/>
       <TextBlock Text="Treść wiadomości"/><TextBox x:Name="CustomerBody" AcceptsReturn="True" Height="125" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
       <TextBlock Text="Zmienne: {klient}, {miesiac} i {data}" Foreground="#526477" Margin="0,0,0,12"/>
       <TextBlock Text="Katalog z dokumentami"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Wybierz…" Click="BrowseDirectory"/><TextBox x:Name="CustomerDirectory"/></DockPanel>
       <TextBlock x:Name="ZipPasswordLabel" Text="Hasło ZIP"/>
       <PasswordBox x:Name="CustomerPassword"/>
       <CheckBox x:Name="CustomerActive" Content="Firma aktywna" IsChecked="True" Margin="0,6,0,10"/>
       <Button Content="Zapisz firmę" Click="SaveCustomer" HorizontalAlignment="Left"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="  SMTP i harmonogram  ">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <Grid Margin="22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Serwer pocztowy" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <TextBlock Text="Host SMTP"/><TextBox x:Name="SmtpHost"/>
       <TextBlock Text="Port"/><TextBox x:Name="SmtpPort"/>
       <TextBlock Text="Bezpieczeństwo połączenia"/><ComboBox x:Name="SmtpSecurity" SelectedIndex="0"><ComboBoxItem Content="STARTTLS (zwykle 587)"/><ComboBoxItem Content="SSL/TLS (zwykle 465)"/></ComboBox>
       <TextBlock Text="Login SMTP"/><TextBox x:Name="SmtpUsername"/>
       <TextBlock x:Name="SmtpPasswordLabel" Text="Hasło SMTP"/><PasswordBox x:Name="SmtpPassword"/>
       <TextBlock Text="Adres e-mail nadawcy"/><TextBox x:Name="SenderEmail"/>
       <TextBlock Text="Nazwa nadawcy"/><TextBox x:Name="SenderName"/>
       <TextBlock Text="Adres e-mail do powiadomień o błędach" Margin="0,8,0,0"/><TextBox x:Name="ErrorNotificationEmail"/>
       <TextBlock Text="Opcjonalny. Otrzymuje powiadomienia o błędach i niepewnych wynikach wysyłki, w tym o niezgodności pracodawcy w PDF." TextWrapping="Wrap" Foreground="#526477" Margin="0,0,0,8"/>
       <WrapPanel><Button Content="Zapisz konfigurację" Click="SaveSettings"/><Button Content="Test połączenia" Click="TestConnection"/></WrapPanel>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="Limity i harmonogram" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <TextBlock Text="Maksymalny rozmiar ZIP (MB, 1–100)"/><TextBox x:Name="AttachmentLimit"/>
       <TextBlock Text="Maksymalny rozmiar plików źródłowych (MB, 1–2048)"/><TextBox x:Name="SourceLimit"/>
       <TextBlock Text="Liczba prób SMTP (1–5)"/><TextBox x:Name="RetryCount"/>
       <Separator Margin="0,14"/>
       <CheckBox x:Name="ScheduleEnabled" Content="Włącz automatyczną wysyłkę codzienną" Margin="0,6,0,16"/>
       <TextBlock Text="Godziny wysyłki zbiorczej (HH:mm, oddzielone przecinkami)" TextWrapping="Wrap"/><TextBox x:Name="ScheduleTime"/>
       <TextBlock Text="Np. 09:00, 13:00, 16:30. Możesz podać jedną lub więcej godzin." TextWrapping="Wrap" Foreground="#526477"/>
       <TextBlock Text="Retencja archiwum (dni, domyślnie 90)" Margin="0,8,0,0"/><TextBox x:Name="ArchiveRetentionDays"/>
       <Separator Margin="0,14"/>
       <TextBlock Text="Reguły plików" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <TextBlock Text="Wzorce obsługują * i ?. Pierwsza pasująca aktywna reguła decyduje, z jakim harmonogramem plik zostanie wysłany." TextWrapping="Wrap" Foreground="#526477" Margin="0,0,0,8"/>
       <DataGrid x:Name="FileRulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                 Height="230" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="Wł." Width="46">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Włącz/wyłącz regułę"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTemplateColumn Header="Nazwa / wzorzec" Width="*" MinWidth="180">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="2" Padding="4,2"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTemplateColumn Header="Tryb" Width="135">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <ComboBox SelectedValue="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Margin="2">
             <ComboBoxItem Content="Wg godzin" Tag="{x:Static core:FileDispatchMode.Scheduled}"/>
             <ComboBoxItem Content="Interwał" Tag="{x:Static core:FileDispatchMode.Interval}"/>
            </ComboBox>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTemplateColumn Header="Min." Width="70">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <TextBox Text="{Binding IntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="2" Padding="4,2" HorizontalContentAlignment="Center"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <WrapPanel Margin="0,6,0,0">
        <Button Content="Dodaj regułę" Click="AddFileRule"/>
        <Button Content="Usuń regułę" Click="RemoveFileRule"/>
        <Button Content="Włącz/wyłącz" Click="ToggleFileRule"/>
        <Button Content="W górę" Click="MoveFileRuleUp"/>
        <Button Content="W dół" Click="MoveFileRuleDown"/>
       </WrapPanel>
       <TextBlock Text="Reguły „Wg godzin” są pakowane razem i wysyłane o godzinach podanych wyżej. Reguły „Interwał” są grupowane według liczby minut — np. wszystkie reguły 15-minutowe trafiają do jednego ZIP-a, a reguły 60-minutowe do osobnego. Wyłączona reguła nie bierze udziału w wysyłce. Uwzględniane są tylko pliki bezpośrednio w katalogu firmy; podkatalogi są pomijane." TextWrapping="Wrap" Foreground="#526477" Margin="0,8"/>
      </StackPanel>
     </Grid>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="  Wysyłka i podgląd  ">
    <DockPanel Margin="14">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel><TextBlock Text="Okres (RRRR-MM)" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="Period" Width="100"/>
       <Button Content="Podgląd wszystkich aktywnych" Click="PreviewAll"/><Button Content="Podgląd wybranej firmy" Click="PreviewSelected"/></WrapPanel>
      <CheckBox x:Name="AllowResend" Content="Zezwól na ponowną wysyłkę w tym okresie" Margin="0,4,0,12"/>
     </StackPanel>
     <WrapPanel DockPanel.Dock="Bottom"><Button x:Name="SendButton" Content="Wyślij przygotowane wiadomości…" Click="SendPrepared" IsEnabled="False"/><Button Content="Wyczyść podgląd" Click="ClearPreview"/></WrapPanel>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="240"/></Grid.RowDefinitions>
      <DataGrid x:Name="PreviewGrid" SelectionMode="Single" SelectionChanged="PreviewSelectedMail">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Firma" Binding="{Binding Name}" Width="140"/>
        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="180"/>
        <DataGridTextColumn Header="Pliki" Binding="{Binding FileCount}" Width="50"/>
        <DataGridTextColumn Header="ZIP" Binding="{Binding ZipSize}" Width="90"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="300"/>
       </DataGrid.Columns>
      </DataGrid>
      <Grid Grid.Row="1" Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <DockPanel><TextBlock x:Name="PreviewSubject" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBox x:Name="PreviewBody" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel>
       <DockPanel Grid.Column="2"><TextBlock Text="Pliki w ZIP" DockPanel.Dock="Top" FontWeight="SemiBold"/><ListBox x:Name="PreviewFiles" DisplayMemberPath="RelativePath" Margin="0,5,0,9"/></DockPanel>
      </Grid>
     </Grid>
    </DockPanel>
   </TabItem>
   <TabItem Header="  Aktualizacje  ">
    <StackPanel Margin="28" MaxWidth="680" HorizontalAlignment="Left">
     <TextBlock Text="Aktualizacje MP Mail" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <TextBlock Text="Wersja zainstalowana"/><TextBlock x:Name="CurrentVersionText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="Najnowsza wersja na GitHub"/><TextBlock x:Name="LatestVersionText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <TextBlock x:Name="UpdateStatusText" Text="Sprawdzanie dostępności aktualizacji…" TextWrapping="Wrap" Foreground="#526477" Margin="0,0,0,16"/>
     <WrapPanel>
      <Button Content="Sprawdź aktualizacje" Click="CheckUpdates"/>
      <Button x:Name="InstallUpdateButton" Content="Pobierz i zainstaluj aktualizację" Click="InstallUpdate" IsEnabled="False"/>
     </WrapPanel>
     <TextBlock Text="Aktualizacje są pobierane wyłącznie z oficjalnych GitHub Releases repozytorium Pawel-sp9pw/mp-mail. Przed uruchomieniem instalatora program weryfikuje sumę SHA-256 z pliku SHA256SUMS.txt opublikowanego razem z wydaniem." TextWrapping="Wrap" Foreground="#526477" Margin="0,18,0,0"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="  Historia wysyłek  ">
    <DockPanel Margin="14">
     <WrapPanel DockPanel.Dock="Top"><Button Content="Odśwież" Click="RefreshLogs"/><TextBlock Text="Ostatnie 1000 zdarzeń · czas lokalny" VerticalAlignment="Center"/></WrapPanel>
     <DataGrid x:Name="LogsGrid">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Data" Binding="{Binding LocalTime}" Width="145"/>
       <DataGridTextColumn Header="Firma" Binding="{Binding CustomerName}" Width="130"/>
       <DataGridTextColumn Header="Okres" Binding="{Binding Period}" Width="75"/>
       <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
       <DataGridTextColumn Header="Informacja" Binding="{Binding Detail}" Width="*" MinWidth="400"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
